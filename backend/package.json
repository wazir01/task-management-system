{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "Task management REST API with RBAC",
  "main": "src/index.js",
  "scripts": {
    "start": "node scripts/prepare-db.js && node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "node scripts/set-db-provider.js && prisma generate",
    "postinstall": "node scripts/set-db-provider.js && prisma generate",
    "db:migrate": "node scripts/db-sync.js",
    "db:push": "node scripts/set-db-provider.js && prisma db push",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "web-push": "^3.6.7",
    "prisma": "^6.8.2"
  }
}
