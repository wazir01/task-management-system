# Local PostgreSQL (Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
# Railway: link the PostgreSQL plugin — DATABASE_URL is set automatically
JWT_SECRET="change-this-to-a-long-random-string"
PORT=3001
NODE_ENV=development

# Email (optional — logs to console if unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=TaskFlow <your@gmail.com>

# Web push (optional — generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
